# Copy to .env and chmod 600. Never commit the .env.

# A NEW bot from @BotFather. The Nautilus bot's token will not do: two
# processes long-polling one token fail with 409 Conflict.
TELEGRAM_BOT_TOKEN=

# Numeric ids, comma-separated — @userinfobot tells you yours.
TELEGRAM_ALLOWED_USER_IDS=

# Required: receipts are read by Claude (platform.claude.com → API keys).
ANTHROPIC_API_KEY=
# The model that reads them, and how hard it thinks. Opus 5.5 is the most accurate;
# claude-sonnet-5-5 costs about half and claude-haiku-5-5 about a fortieth.
# ARGOS_MODEL=claude-opus-5-5
# ARGOS_EFFORT=low

# Optional: the most a day of reading may cost, in dollars; reading pauses until midnight past it.
# ARGOS_DAILY_BUDGET_USD=1.00
# How often to back up the database into the volume's /data/backups — whole minutes, at least
# 1m: 30m, 6h, 1d, 7d — and how many backups to keep there; 0 turns them off.
# ARGOS_BACKUP_EVERY=1d
# ARGOS_BACKUP_KEEP=14
# When the monthly digest goes out on the 1st, local time; off for never.
# ARGOS_DIGEST_AT=09:00
# true keeps no receipt files: read from memory, and the ones kept before are deleted at startup.
# ARGOS_DELETE_RECEIPTS=false

# Optional: import expenses from banks through Open Finance, with Pluggy. Each person has an
# application of their own at dashboard.pluggy.ai → Applications; docs/DETAILS.md, "Importing
# from the bank", has the steps. Without a Telegram id, for everyone who has none of their own:
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# Ending in a Telegram id from the allowlist, that person's:
# PLUGGY_CLIENT_ID_123456789=
# PLUGGY_CLIENT_SECRET_123456789=
# How often to ask Pluggy whether a bank changed; Meu Pluggy refreshes banks once a day.
# PLUGGY_SYNC_EVERY=1h

# Optional: the database in a browser, with editing (make db-web). It will not start without a password.
# SQLITE_WEB_PASSWORD=
# 127.0.0.1 unless set; this host's Tailscale address to reach it from the tailnet. Never 0.0.0.0.
# SQLITE_WEB_ADDR=127.0.0.1
# SQLITE_WEB_PORT=8081
