# Copy to .env and chmod 600. Never commit the .env.

# A NEW bot from @BotFather. The Nautilus bot's token will not do: two
# processes long-polling one token fail with 409 Conflict.
TELEGRAM_BOT_TOKEN=

# Numeric ids, comma-separated — @userinfobot tells you yours.
TELEGRAM_ALLOWED_USER_IDS=

# Required: receipts are read by Claude (platform.claude.com → API keys).
ANTHROPIC_API_KEY=
# The model that reads them, and how hard it thinks. Opus 5.5 is the most accurate;
# claude-sonnet-5-5 costs about half and claude-haiku-5-5 about a fortieth.
# ARGOS_MODEL=claude-opus-5-5
# ARGOS_EFFORT=low

# Optional: the database in a browser, with editing (make db-web). It will not start without a password.
# SQLITE_WEB_PASSWORD=
# 127.0.0.1 unless set; this host's Tailscale address to reach it from the tailnet. Never 0.0.0.0.
# SQLITE_WEB_ADDR=127.0.0.1
# SQLITE_WEB_PORT=8081
